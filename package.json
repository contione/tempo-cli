{
  "name": "@contione/tempo-cli",
  "version": "0.1.4",
  "description": "A focused command-line client for Tempo Cloud and Jira",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p . && node scripts/manifest.cjs",
    "prepack": "npm run build",
    "test": "cross-env TZ=Europe/Warsaw jest --runInBand",
    "lint": "eslint .",
    "test:watch": "cross-env TZ=Europe/Warsaw jest --watch",
    "test:api": "cross-env TZ=Europe/Warsaw vitest run test/api.spec.ts test/identity.spec.ts",
    "release:check": "npm run build && npm test && npm run test:api && npm run lint"
  },
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/contione/tempo-cli",
  "bugs": "https://github.com/contione/tempo-cli/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/contione/tempo-cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tempo": "bin/run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "tempo",
    "tempo-cli",
    "cli",
    "tempo cloud",
    "tempo.io",
    "jira"
  ],
  "oclif": {
    "topics": {
      "alias": {
        "description": "manage issue key aliases"
      },
      "tracker": {
        "description": "manage issue time trackers"
      }
    },
    "commands": "./dist/commands",
    "bin": "tempo",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-warn-if-update-available",
      "@oclif/plugin-autocomplete"
    ],
    "warn-if-update-available": {
      "timeoutInDays": 7
    },
    "helpOptions": {
      "hideAliasesFromRoot": true
    }
  },
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "4.2.10",
    "@oclif/plugin-autocomplete": "1.4.6",
    "@oclif/plugin-help": "6.2.27",
    "@oclif/plugin-warn-if-update-available": "3.1.38",
    "@types/lodash": "^4.17.16",
    "chalk": "^3.0.0",
    "cli-table3": "^0.5.1",
    "cli-truncate": "^2.1.0",
    "cli-ux": "^6.0.9",
    "date-fns": "^2.30.0",
    "globby": "^14.1.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "@types/jest": "^25.2.3",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  }
}
